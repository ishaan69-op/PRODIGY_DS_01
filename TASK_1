   "source": [
    "## 4. Histogram — Distribution of Population Across All Countries\n",
    "Population size is heavily right-skewed (a handful of countries are extremely large),\n",
    "so a log10 transform reveals the true shape of the distribution."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "6bb31bb6",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-05T19:54:22.830870Z",
     "iopub.status.busy": "2026-07-05T19:54:22.830725Z",
     "iopub.status.idle": "2026-07-05T19:54:23.118667Z",
     "shell.execute_reply": "2026-07-05T19:54:23.117811Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1100x660 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "countries_df[\"log_pop\"] = np.log10(countries_df[LATEST_YEAR])\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.histplot(countries_df[\"log_pop\"], bins=20, color=\"#4C72B0\", edgecolor=\"white\")\n",
    "plt.xlabel(\"Population (log10 scale)\")\n",
    "plt.ylabel(\"Number of Countries\")\n",
    "plt.title(\"Distribution of Country Population Sizes (2024)\", fontsize=14, weight=\"bold\")\n",
    "\n",
    "tick_vals = [4, 5, 6, 7, 8, 9]\n",
    "tick_labels = [\"10K\", \"100K\", \"1M\", \"10M\", \"100M\", \"1B\"]\n",
    "plt.xticks(tick_vals, tick_labels)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"chart2_population_histogram.png\", bbox_inches=\"tight\")\n",
    "plt.show()\n"
   ]
