   "source": [
    "# The World Bank CSV has 4 metadata rows before the actual header\n",
    "df = pd.read_csv(\"population.csv\", skiprows=4)\n",
    "meta = pd.read_csv(\"metadata_country.csv\")\n",
    "\n",
    "LATEST_YEAR = \"2024\"\n",
    "df.head()\n"
   ]
  },
